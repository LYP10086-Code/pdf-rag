# ---------- 模型服务运行时（embedder / reranker 共用，torch CPU）----------
# 只包含模型服务与配置读取，不打包业务代码；客户端一致性由
# api 与 model 镜像在同一 commit 中一起构建保证
FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

# CPU 版 torch，避免把 CUDA 依赖打进镜像
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements-model.txt .
RUN pip install --no-cache-dir -r requirements-model.txt

COPY app/__init__.py app/__init__.py
COPY app/embedder_server.py app/reranker_server.py app/
COPY app/core/__init__.py app/core/
COPY app/core/config.py app/core/

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# 默认跑 embedder；compose 中 reranker 服务会覆盖 command
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "app.embedder_server:app", "--host", "0.0.0.0", "--port", "8001"]
