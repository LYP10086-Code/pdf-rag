# ============================================================================
# pdf-rag 本地化部署配置（复制为 .env 后按需修改）
# 注意：.env 含密码，不要提交到 Git
# ============================================================================

# --- PostgreSQL（docker compose 中的 postgres 服务）---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb
# 应用侧连接串，密码必须与 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql+psycopg://raguser:change-me-strong-password@localhost:5432/ragdb

# --- Qdrant（docker compose 中的 qdrant 服务）---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_knowledge
QDRANT_VECTOR_SIZE=1024

# --- vLLM / Qwen3-4B-AWQ（OpenAI 兼容接口）---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen3-4B-AWQ
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1
# vLLM --max-model-len=4096：上下文预算 + 生成长度需控制在 4096 以内
LLM_MAX_TOKENS=768

# --- Embedding / Reranker（CPU，避免与 LLM 争显存）---
HF_ENDPOINT=https://hf-mirror.com
# 模型已缓存后可设为 1，跳过联网版本检查
HF_HUB_OFFLINE=0
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512

# --- 检索参数（沿用 78 题评测结论）---
RETRIEVAL_CANDIDATE_DEPTH=20
RETRIEVAL_DEFAULT_K=5
HYBRID_BM25_WEIGHT=0.2
RRF_K=60
# 上下文预算：2500 字符 ≈ 2500 token，为 4096 窗口留出系统提示、问题与生成空间
CONTEXT_BUDGET_CHARS=2500

# --- 分块参数（bge-m3 8192 窗口下的安全值）---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 提示框补充块超长时的再切分上限
SUPPLEMENT_MAX_CHARS=6000
# 父块 floor-merge 下限聚合：小碎片父块（<300 字符）与同章同节内相邻碎片
# 合并（合并后 ≤1000），减少"标题行导语"类碎片父块；breadcrumb 取首个碎片
PARENT_MERGE_ENABLED=true
PARENT_MERGE_FLOOR_CHARS=300
PARENT_MERGE_CEILING_CHARS=1000

# --- 提示框几何检测（物理签名，随 PDF 模板调整；默认值为秦PLUS EV 手册实测，
#     全书 302 页验证：184 个标题条 100% 命中、0 例框内表格、2 例跨页框）---
# 关闭后提示框补充块退回文本启发式定界（旧行为）
BOX_DETECT_ENABLED=true
# 标题条填充色（唯一性签名）与颜色容差
BOX_BAR_FILL_HEX=#ffe3bf
BOX_COLOR_TOLERANCE=0.02
# 标题条尺寸范围（pt）
BOX_BAR_MIN_WIDTH_PT=300
BOX_BAR_MAX_WIDTH_PT=380
BOX_BAR_MIN_HEIGHT_PT=18
BOX_BAR_MAX_HEIGHT_PT=32
# 体部底边线搜索窗口（pt）与 x 对齐容差（pt）
BOX_BOTTOM_SEARCH_PT=400
BOX_X_TOLERANCE_PT=5

# --- PDF 解析：项目自研解析链路（标题物理探测 + 表格重建 + 清洗）---
PDF_PARSER=custom

# --- 容器部署（docker compose 的 api 服务）---
# 本地构建镜像后可填 pdf-rag-api:local
RAG_API_IMAGE=pdf-rag-api:local
# 宿主机映射端口；首次验证可改成 8081 避免与现有 uvicorn 冲突
API_PORT=8080
# 宿主机 storage 与模型缓存目录（WSL 使用 Linux 绝对路径）
STORAGE_HOST_DIR=./storage
HF_CACHE_DIR=./data/huggingface

# --- 存储与业务默认值 ---
MAX_UPLOAD_MB=200
STORAGE_DIR=storage
DEFAULT_USER_ID=local
DEFAULT_KB_ID=default
CHAT_MODE=rag
AGENT_MAX_ITERATIONS=3
LOG_LEVEL=INFO
